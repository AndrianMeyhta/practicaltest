{
  "name": "mutasi-stok-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API mutasi stok antar gudang",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test:database": "node --env-file-if-exists=.env scripts/verify-database.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "3.24.6"
  }
}
